[Unit]
Description=SSH tunnel: localhost:8090 -> jetson1 ESP32-S3 camera viewer
After=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o BatchMode=yes -L 8090:127.0.0.1:8090 jetson1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
