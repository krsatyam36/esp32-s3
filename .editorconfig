root = true

[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8
end_of_line = lf

[Makefile]
indent_style = tab

[*.{html,css,js,json,yml,yaml}]
indent_size = 2

[*.{c,cpp,h,hpp,ino}]
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{md,rst}]
trim_trailing_whitespace = false

[*.{toml,cfg,ini}]
indent_size = 2
